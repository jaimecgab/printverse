# Copy this file to .env and fill every empty credential before starting.
# Generate JWT_SECRET with: openssl rand -hex 32

POSTGRES_DB=printverse
POSTGRES_USER=printverse
POSTGRES_PASSWORD=

JWT_SECRET=
JWT_DURATION=8h
APP_ADMIN_USERNAME=admin
APP_ADMIN_DISPLAY_NAME=Administrador
APP_ADMIN_PASSWORD=

# Public host port for the only exposed service (Nginx frontend).
FRONTEND_PORT=8088

# Set true only when adopting the verified pre-Flyway schema equivalent to V1.
FLYWAY_BASELINE_ON_MIGRATE=false

# Optional for clients that access the backend outside the same-origin proxy.
CORS_ALLOWED_ORIGINS=http://localhost:8088
